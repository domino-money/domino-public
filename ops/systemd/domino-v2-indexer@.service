[Unit]
Description=Domino V2 index for %i (read-v6)
After=postgresql@16-domino.service domino-continuous-egress.service
BindsTo=domino-continuous-egress.service
PartOf=domino-public-data.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=domino-write
Group=domino-write
SupplementaryGroups=domino-db
WorkingDirectory=@PUBLIC_ROOT@/current/backend
# The writer reads only the names continuous_egress_policy.py pinned with its
# egress set, never a DNS answer outside that set (#315).
BindReadOnlyPaths=/etc/domino/continuous-reads/write.hosts:/etc/hosts
# The instance is the chain profile (robinhood-4663, base-8453, arbitrum-42161).
# Robinhood reads the writer's provider file, which leads with the node's
# loopback proxy, and never the chain RPC file. Base and Arbitrum read the
# writer's private V2 chain RPC file (backend/v2_rpc.py). Its providers' URLs
# carry their keys, sealed on the host as v2-rpc-<chain>-<name>. Its loader
# checks every chain it names, so every one of them is imported. Registration
# is a one-time step before the first start (docs/v2/V2_INDEXER_READ_API.md,
# "Operating it").
ImportCredential=v2-rpc-*
# The credentials are sealed with the host's TPM. systemd 255 opens the TPM
# to the device policy for LoadCredentialEncrypted= but not for
# ImportCredential=, and under PrivateDevices=yes the decryption then fails
# with EPERM on /dev/tpmrm0. The plan listener did, on 4 Oct.
DeviceAllow=char-tpm rw
# The chain's automation writes why each vault and mandate waits to its public
# file (install_v2_automation.py); the index serves it to read-v6. A file not
# there yet leaves the chain's waiting unavailable, never the pass.
ExecStart=@QUEUE_ROOT@/venv/bin/python -B v2_indexer.py follow --chain %i --chain-rpc-file @QUEUE_ROOT@/release/backend/runtime/chain-rpc.json --waiting-file /var/lib/domino-v2-automation-public/%i.waiting.json
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# `follow` returns 0 after five failed rounds in a row (a refused head included),
# so only `always` brings it back.
Restart=always
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
TasksMax=32
MemoryMax=512M
CPUQuota=100%

# Installed by install_public_data.py and never enabled there: an instance starts
# only on `systemctl enable --now domino-v2-indexer@<profile>.service`, after 052
# and `v2_indexer.py register`.
[Install]
WantedBy=domino-public-data.target
