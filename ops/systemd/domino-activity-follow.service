[Unit]
Description=Domino pool activity for every pool holding a Domino position
After=postgresql@16-domino.service domino-continuous-egress.service
BindsTo=domino-continuous-egress.service
PartOf=domino-public-data.target
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=oneshot
User=domino-write
Group=domino-write
SupplementaryGroups=domino-db
WorkingDirectory=@PUBLIC_ROOT@/current/backend
# The writer reads only the names continuous_egress_policy.py pinned with its
# egress set, never a DNS answer outside that set (#315).
BindReadOnlyPaths=/etc/domino/continuous-reads/write.hosts:/etc/hosts
# The pools come from the Setup contract's SetupMinted events on every run, so a
# new Domino pool joins without editing this unit; one it cannot register (the
# catalogue lacks its Initialize block) is reported under notRegistered. 35 s
# keeps the run, its start-up and a step in progress inside the timer's minute.
ExecStart=@QUEUE_ROOT@/venv/bin/python -B manage_activity.py --follow --domino-positions --quiet --span 100000 --span-floor 10 --span-ceiling 100000 --max-passes 1 --lag 100 --max-consecutive-failures 20 --max-rpc-calls 200000 --max-header-calls 200000
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
