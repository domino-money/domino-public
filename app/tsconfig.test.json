{
  "compilerOptions": {
    "outDir": ".test-build",
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "api-contracts/*": ["../api-contracts/*"]
    }
  },
  "files": [
    "src/lib/scenario.ts",
    "src/lib/geometry.ts",
    "src/lib/markets.ts",
    "../web/lib/compound.ts",
    "../web/lib/position.ts",
    "functions/_lib/gate.ts",
    "functions/_middleware.ts",
    "functions/_lib/bridge.ts",
    "functions/api/[[path]].ts",
    "src/lib/read/pin.ts",
    "src/lib/read/types.ts",
    "src/lib/read/errors.ts",
    "src/lib/read/interpret.ts",
    "src/lib/read/pipeline.ts",
    "src/lib/read/bridgeSource.ts",
    "src/lib/read/fixtureSource.ts",
    "src/lib/read/scenarios.ts",
    "src/lib/read/scheduler.ts",
    "src/lib/read/decimal.ts",
    "src/lib/read/project.ts",
    "src/lib/read/pagers.ts",
    "src/lib/read/marketsProvider.ts",
    "src/lib/read/deferredMarkets.ts",
    "src/config/selectedPools.ts",
    "src/session/api.ts",
    "src/session/errors.ts",
    "src/session/siwe.ts",
    "src/session/machine.ts",
    "src/session/controller.ts",
    "src/session/privateQuery.ts"
  ]
}
