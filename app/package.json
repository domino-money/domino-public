{
  "name": "domino-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:render": "node --test tests/render.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src functions",
    "test:gate": "node --test tests/gate.browser.test.mjs && npm run test:read",
    "build:fixtures": "vite build --mode fixtures",
    "build:bridge-test": "vite build --mode bridge-test",
    "test:read": "npm run build:fixtures && npm run build:bridge-test && node --test tests/read-states.browser.test.mjs tests/read-bridge.browser.test.mjs",
    "serve:gated": "node scripts/gated-server.mjs",
    "deploy:preview": "npm run build && npx --yes wrangler@4.130.0 pages deploy --branch preview",
    "deploy": "npm run build && npx --yes wrangler@4.130.0 pages deploy --branch main"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "^22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-core": "^1.56.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^7.1.0"
  }
}
