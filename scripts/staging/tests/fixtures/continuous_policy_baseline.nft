# The continuous policy as installed on the home VM on 2026-09-18, with every
# pinned address and identity number replaced by a placeholder. The renderer
# must describe this file exactly and add only the four missing identities.
# Explicit continuous operator pins; no DNS-TTL qualification claim.
add table inet domino_continuous_reads
delete table inet domino_continuous_reads
add table inet domino_continuous_reads
add chain inet domino_continuous_reads output { type filter hook output priority 10; policy accept; }
add chain inet domino_continuous_reads read
add counter inet domino_continuous_reads denied_read
add rule inet domino_continuous_reads output meta skuid <uid> jump read
add rule inet domino_continuous_reads read oifname "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp sport 8876 ct direction reply ct state established counter accept comment "exact listener reply"
add set inet domino_continuous_reads read_ipv4 { type ipv4_addr; elements = { <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip> }; }
add rule inet domino_continuous_reads read oifname != "lo" ip daddr @read_ipv4 tcp dport 443 counter accept comment "operator pinned external"
add rule inet domino_continuous_reads read counter name denied_read drop
add chain inet domino_continuous_reads gateway
add counter inet domino_continuous_reads denied_gateway
add rule inet domino_continuous_reads output meta skuid <uid> jump gateway
add rule inet domino_continuous_reads gateway oifname "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp sport 8878 ct direction reply ct state established counter accept comment "exact listener reply"
add set inet domino_continuous_reads gateway_ipv4 { type ipv4_addr; elements = { <ip>, <ip> }; }
add rule inet domino_continuous_reads gateway oifname != "lo" ip daddr @gateway_ipv4 tcp dport 443 counter accept comment "operator pinned external"
add rule inet domino_continuous_reads gateway oifname "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp dport 8876 ct direction original counter accept comment "exact read origin"
add rule inet domino_continuous_reads gateway counter name denied_gateway drop
add chain inet domino_continuous_reads auth
add counter inet domino_continuous_reads denied_auth
add rule inet domino_continuous_reads output meta skuid <uid> jump auth
add rule inet domino_continuous_reads auth oifname "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp sport 8879 ct direction reply ct state established counter accept comment "exact listener reply"
add rule inet domino_continuous_reads auth counter name denied_auth drop
add chain inet domino_continuous_reads onboarding
add counter inet domino_continuous_reads denied_onboarding
add rule inet domino_continuous_reads output meta skuid <uid> jump onboarding
add rule inet domino_continuous_reads onboarding oifname "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp sport 8880 ct direction reply ct state established counter accept comment "exact listener reply"
add rule inet domino_continuous_reads onboarding counter name denied_onboarding drop
add chain inet domino_continuous_reads deposit
add counter inet domino_continuous_reads denied_deposit
add rule inet domino_continuous_reads output meta skuid <uid> jump deposit
add rule inet domino_continuous_reads deposit oifname "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp sport 8881 ct direction reply ct state established counter accept comment "exact listener reply"
add rule inet domino_continuous_reads deposit counter name denied_deposit drop
add chain inet domino_continuous_reads tunnel
add counter inet domino_continuous_reads denied_tunnel
add rule inet domino_continuous_reads output meta skuid <uid> jump tunnel
add rule inet domino_continuous_reads tunnel oifname "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp sport 20241 ct direction reply ct state established counter accept comment "exact listener reply"
add set inet domino_continuous_reads tunnel_ipv4 { type ipv4_addr; elements = { <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip>, <ip> }; }
add rule inet domino_continuous_reads tunnel oifname != "lo" ip daddr @tunnel_ipv4 tcp dport 7844 counter accept comment "operator pinned external"
add rule inet domino_continuous_reads tunnel oifname != "lo" ip daddr @tunnel_ipv4 udp dport 7844 counter accept comment "operator pinned external"
add set inet domino_continuous_reads tunnel_jwks_ipv4 { type ipv4_addr; elements = { <ip>, <ip> }; }
add rule inet domino_continuous_reads tunnel oifname != "lo" ip daddr @tunnel_jwks_ipv4 tcp dport 443 counter accept comment "Access middleware JWKS"
add rule inet domino_continuous_reads tunnel oifname "lo" ip daddr 127.0.0.53 tcp dport 53 counter accept comment "tunnel DNS stub"
add rule inet domino_continuous_reads tunnel oifname "lo" ip daddr 127.0.0.53 udp dport 53 counter accept comment "tunnel DNS stub"
add rule inet domino_continuous_reads tunnel oifname "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 tcp dport 8878 ct direction original counter accept comment "exact read origin"
add rule inet domino_continuous_reads tunnel counter name denied_tunnel drop
add set inet domino_continuous_reads write_ipv4 { type ipv4_addr; elements = { <ip>, <ip>, <ip> }; }
add chain inet domino_continuous_reads write
add counter inet domino_continuous_reads denied_write
add rule inet domino_continuous_reads output meta skuid <uid> jump write
add rule inet domino_continuous_reads write oifname "lo" ip daddr 127.0.0.53 udp dport 53 counter accept comment "queue worker resolver"
add rule inet domino_continuous_reads write oifname "lo" ip daddr 127.0.0.53 tcp dport 53 counter accept comment "queue worker resolver"
add rule inet domino_continuous_reads write oifname != "lo" ip daddr @write_ipv4 tcp dport 443 counter accept comment "indexer provider egress"
add rule inet domino_continuous_reads write counter name denied_write drop
add chain inet domino_continuous_reads operator
add counter inet domino_continuous_reads denied_operator
add rule inet domino_continuous_reads output meta skuid <uid> jump operator
add rule inet domino_continuous_reads operator counter name denied_operator drop
add chain inet domino_continuous_reads admin
add counter inet domino_continuous_reads denied_admin
add rule inet domino_continuous_reads output meta skuid <uid> jump admin
add rule inet domino_continuous_reads admin counter name denied_admin drop
