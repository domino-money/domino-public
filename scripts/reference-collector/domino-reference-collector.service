# Candidate only. No automatic start; localhost-only egress is NOT operational.
# Before first start: install this service identity's own release copy and venv,
# its own 0600 catalogue descriptor and provider configuration, the PostgreSQL
# peer mapping and socket-group grant, and the separate egress drop-in pinning
# the two provider destinations. The timer is the entry point, not this service.
[Unit]
Description=Domino external market reference collection (one bounded pass)
Wants=network-online.target
After=network-online.target domino-continuous-egress.service

[Service]
Type=oneshot
User=domino-reference
Group=domino-reference
WorkingDirectory=/opt/domino/reference-collector/release
ExecStart=/usr/bin/env -i HOME=/nonexistent PATH=/usr/bin:/bin LANG=C.UTF-8 PYTHONNOUSERSITE=1 /opt/domino/reference-collector/venv/bin/python3.14 -B backend/collect_reference_prices.py --every-mapping --lookback 3600 --budget-seconds 120 --provider-config /etc/domino/reference-collector/providers.json --store
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=/etc/domino/credentials /opt/domino/releases
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
IPAddressDeny=any
IPAddressAllow=localhost
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=domino-reference-collector
TimeoutStartSec=150
TimeoutStopSec=30
