  "components": {
    "schemas": {
      "ActivityRequest": {
        "properties": {
          "poolId": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "title": "Poolid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "poolId"
        ],
        "title": "ActivityRequest"
      },
      "AssetsRequest": {
        "properties": {
          "wallet": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "Wallet"
          },
          "tokens": {
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Tokens"
          },
          "autoDiscover": {
            "type": "boolean",
            "title": "Autodiscover",
            "default": true
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "wallet"
        ],
        "title": "AssetsRequest"
      },
      "CatalogueRequest": {
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "Token"
          },
          "pairedToken": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pairedtoken"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 20
          },
          "afterPoolId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Afterpoolid"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9.223372036854776e+18,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "CatalogueRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NftPositionsRequest": {
        "properties": {
          "tokenIds": {
            "items": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Tokenids"
          },
          "blockNumber": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9.223372036854776e+18,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Blocknumber"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tokenIds"
        ],
        "title": "NftPositionsRequest"
      },
      "PoolMarketRequest": {
        "properties": {
          "poolId": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "title": "Poolid"
          },
          "includePriceHistory": {
            "type": "boolean",
            "title": "Includepricehistory",
            "default": false
          },
          "priceToken": {
            "type": "string",
            "pattern": "^(base|quote)$",
            "title": "Pricetoken",
            "default": "base"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "poolId"
        ],
        "title": "PoolMarketRequest"
      },
      "PoolsRequest": {
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "Token"
          },
          "pairedToken": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pairedtoken"
          },
          "maxPools": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Maxpools",
            "default": 12
          },
          "poolIds": {
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Poolids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "PoolsRequest"
      },
      "TokenRequest": {
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "TokenRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
