{
  "$defs": {
    "FinancialCoverage": {
      "additionalProperties": false,
      "properties": {
        "externalFlowsComplete": {
          "title": "Externalflowscomplete",
          "type": "boolean"
        },
        "financialRevision": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Financialrevision"
        },
        "methodologyVersion": {
          "const": 1,
          "title": "Methodologyversion",
          "type": "integer"
        },
        "observedSeconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Observedseconds",
          "type": "integer"
        },
        "operatorCostsReason": {
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_]{0,95}$",
          "title": "Operatorcostsreason",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "windowEnd": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Windowend",
          "type": "integer"
        },
        "windowStart": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Windowstart",
          "type": "integer"
        }
      },
      "required": [
        "methodologyVersion",
        "financialRevision",
        "snapshot",
        "windowStart",
        "windowEnd",
        "observedSeconds",
        "externalFlowsComplete",
        "operatorCostsReason"
      ],
      "title": "FinancialCoverage",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "actualServiceFeesUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actualservicefeesusd"
        },
        "externalDepositsUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Externaldepositsusd"
        },
        "externalWithdrawalsUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Externalwithdrawalsusd"
        },
        "grossFeeAprPercent": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grossfeeaprpercent"
        },
        "netFeeAprPercent": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Netfeeaprpercent"
        },
        "netFeeIncomeUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Netfeeincomeusd"
        },
        "newTradingFeesUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Newtradingfeesusd"
        },
        "operatorCostsUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operatorcostsusd"
        },
        "otherStrategyCostsUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Otherstrategycostsusd"
        },
        "projectedApyPercent": {
          "title": "Projectedapypercent",
          "type": "null"
        },
        "reinvestedUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reinvestedusd"
        },
        "timeWeightedCapitalUsd": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^-?(0|[1-9][0-9]{0,511})(\\.[0-9]{1,400})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timeweightedcapitalusd"
        }
      },
      "required": [
        "newTradingFeesUsd",
        "externalDepositsUsd",
        "externalWithdrawalsUsd",
        "reinvestedUsd",
        "actualServiceFeesUsd",
        "otherStrategyCostsUsd",
        "operatorCostsUsd",
        "netFeeIncomeUsd",
        "timeWeightedCapitalUsd",
        "grossFeeAprPercent",
        "netFeeAprPercent",
        "projectedApyPercent"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "MissingCard": {
      "additionalProperties": false,
      "properties": {
        "collectionReason": {
          "const": "epoch_not_found",
          "title": "Collectionreason",
          "type": "string"
        },
        "collectionStatus": {
          "const": "unavailable",
          "title": "Collectionstatus",
          "type": "string"
        },
        "complete24h": {
          "title": "Complete24H",
          "type": "boolean"
        },
        "epochId": {
          "maxLength": 66,
          "minLength": 66,
          "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
          "title": "Epochid",
          "type": "string"
        },
        "executionAvailable": {
          "const": false,
          "title": "Executionavailable",
          "type": "boolean"
        },
        "kind": {
          "const": "not_found",
          "title": "Kind",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "performanceReasons": {
          "items": {
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9_]{0,95}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Performancereasons",
          "type": "array"
        },
        "performanceStatus": {
          "enum": [
            "available",
            "measuring",
            "partial",
            "stale",
            "unavailable"
          ],
          "title": "Performancestatus",
          "type": "string"
        }
      },
      "required": [
        "epochId",
        "performanceStatus",
        "performanceReasons",
        "metrics",
        "complete24h",
        "executionAvailable",
        "kind",
        "collectionStatus",
        "collectionReason"
      ],
      "title": "MissingCard",
      "type": "object"
    },
    "ObservationCounts": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        },
        "pages": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        },
        "receipts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Receipts",
          "type": "integer"
        }
      },
      "required": [
        "pages",
        "receipts",
        "events"
      ],
      "title": "ObservationCounts",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "blockHash": {
          "maxLength": 66,
          "minLength": 66,
          "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
          "title": "Blockhash",
          "type": "string"
        },
        "blockNumber": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Blocknumber",
          "type": "integer"
        },
        "timestamp": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        }
      },
      "required": [
        "blockNumber",
        "blockHash",
        "timestamp"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "TrackedCard": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/Snapshot"
        },
        "collectionReason": {
          "enum": [
            "forward_observations_only",
            "latest_read_failed",
            "snapshot_stale",
            "canonical_replay_required",
            "baseline_reorged"
          ],
          "title": "Collectionreason",
          "type": "string"
        },
        "collectionStatus": {
          "enum": [
            "measuring",
            "partial",
            "stale",
            "unavailable"
          ],
          "title": "Collectionstatus",
          "type": "string"
        },
        "complete24h": {
          "title": "Complete24H",
          "type": "boolean"
        },
        "epochId": {
          "maxLength": 66,
          "minLength": 66,
          "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
          "title": "Epochid",
          "type": "string"
        },
        "executionAvailable": {
          "const": false,
          "title": "Executionavailable",
          "type": "boolean"
        },
        "financial": {
          "$ref": "#/$defs/FinancialCoverage"
        },
        "kind": {
          "const": "tracked",
          "title": "Kind",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "observations": {
          "$ref": "#/$defs/ObservationCounts"
        },
        "observedSeconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Observedseconds",
          "type": "integer"
        },
        "performanceReasons": {
          "items": {
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9_]{0,95}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Performancereasons",
          "type": "array"
        },
        "performanceStatus": {
          "enum": [
            "available",
            "measuring",
            "partial",
            "stale",
            "unavailable"
          ],
          "title": "Performancestatus",
          "type": "string"
        },
        "positionManager": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$",
          "title": "Positionmanager",
          "type": "string"
        },
        "replayGeneration": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Replaygeneration",
          "type": "integer"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "rootTokenId": {
          "maxLength": 78,
          "pattern": "^[1-9][0-9]{0,77}$(?![\\s\\S])",
          "title": "Roottokenid",
          "type": "string",
          "x-maximum-raw": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
        },
        "sequenceIdentity": {
          "maxLength": 66,
          "minLength": 66,
          "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$",
          "title": "Sequenceidentity",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "snapshotAgeSeconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Snapshotageseconds",
          "type": "integer"
        },
        "vault": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$",
          "title": "Vault",
          "type": "string"
        }
      },
      "required": [
        "epochId",
        "performanceStatus",
        "performanceReasons",
        "metrics",
        "complete24h",
        "executionAvailable",
        "kind",
        "vault",
        "positionManager",
        "rootTokenId",
        "sequenceIdentity",
        "baseline",
        "snapshot",
        "revision",
        "replayGeneration",
        "collectionStatus",
        "collectionReason",
        "observedSeconds",
        "snapshotAgeSeconds",
        "observations",
        "financial"
      ],
      "title": "TrackedCard",
      "type": "object"
    }
  },
  "$id": "https://domino.invalid/contracts/performance-v2/cards.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cards": {
      "items": {
        "discriminator": {
          "mapping": {
            "not_found": "#/$defs/MissingCard",
            "tracked": "#/$defs/TrackedCard"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TrackedCard"
          },
          {
            "$ref": "#/$defs/MissingCard"
          }
        ]
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Cards",
      "type": "array"
    },
    "chainId": {
      "const": 4663,
      "title": "Chainid",
      "type": "integer"
    },
    "contractVersion": {
      "const": "2.0.0-rc.1",
      "title": "Contractversion",
      "type": "string"
    },
    "executionAvailable": {
      "const": false,
      "title": "Executionavailable",
      "type": "boolean"
    },
    "owner": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$",
      "title": "Owner",
      "type": "string"
    },
    "refreshAfterSeconds": {
      "enum": [
        30,
        60
      ],
      "title": "Refreshafterseconds",
      "type": "integer"
    }
  },
  "required": [
    "contractVersion",
    "chainId",
    "owner",
    "refreshAfterSeconds",
    "executionAvailable",
    "cards"
  ],
  "title": "CardsResponse",
  "type": "object",
  "x-contract-version": "2.0.0-rc.1",
  "x-domino-constraints": [
    "Strict safe JSON integers; nonzero canonical lowercase identities; unique requested/result epochs.",
    "Cards accept 1..8 epochIds; enrollment accepts a vault and complete token set. Owner comes from the authenticated session.",
    "Financial USD/APR amounts are decimal strings or null; APR requires available complete24h; APY and execution remain disabled.",
    "Collection spans are snapshot.timestamp minus baseline.timestamp, not fee/capital coverage.",
    "Same block number means same hash; snapshots cannot precede baseline.",
    "Collection reason, status and 120-second age boundary must agree.",
    "Pages zero implies receipts/events zero; receipts zero implies events zero.",
    "The runtime also enforces cross-field semantics and x-maximum-raw, beyond generic schema checks.",
    "Owner/epoch request binding and session reauthorization remain server/consumer integration checks."
  ]
}
