            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Settledfeesraw",
          "type": "array"
        },
        "tickLower": {
          "maximum": 887272,
          "minimum": -887272,
          "title": "Ticklower",
          "type": "integer"
        },
        "tickUpper": {
          "maximum": 887272,
          "minimum": -887272,
          "title": "Tickupper",
          "type": "integer"
        },
