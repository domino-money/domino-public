{
  "$id": "https://domino.invalid/contracts/read-v1/wallet-assets.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "autoDiscover": {
      "default": true,
      "title": "Autodiscover",
      "type": "boolean"
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "tokens": {
      "items": {
        "pattern": "^0x[0-9a-fA-F]{40}$",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Tokens",
      "type": "array"
    },
    "wallet": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Wallet",
      "type": "string"
    }
  },
  "required": [
    "wallet"
  ],
  "title": "AssetsRequest",
  "type": "object",
  "x-contract-version": "1.1.0-rc.3"
}
