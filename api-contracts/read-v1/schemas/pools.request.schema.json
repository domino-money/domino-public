{
  "$id": "https://domino.invalid/contracts/read-v1/pools.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "maxPools": {
      "default": 12,
      "maximum": 20,
      "minimum": 1,
      "title": "Maxpools",
      "type": "integer"
    },
    "pairedToken": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pairedtoken"
    },
    "poolIds": {
      "items": {
        "pattern": "^0x[0-9a-fA-F]{64}$",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Poolids",
      "type": "array"
    },
    "token": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Token",
      "type": "string"
    }
  },
  "required": [
    "token"
  ],
  "title": "PoolsRequest",
  "type": "object",
  "x-contract-version": "1.1.0-rc.3",
  "x-domino-constraints": [
    "pairedToken must differ from token case-insensitively",
    "poolIds length must not exceed maxPools (default 12)"
  ]
}
