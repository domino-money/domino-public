{
  "$id": "https://domino.invalid/contracts/read-v1/catalogue.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "afterPoolId": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Afterpoolid"
    },
    "limit": {
      "default": 20,
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "pairedToken": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pairedtoken"
    },
    "revision": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "token": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Token",
      "type": "string"
    }
  },
  "required": [
    "token"
  ],
  "title": "CatalogueRequest",
  "type": "object",
  "x-contract-version": "1.1.0-rc.3",
  "x-domino-constraints": [
    "pairedToken must differ from token case-insensitively",
    "revision required when afterPoolId is supplied"
  ]
}
