        },
        "hooks": {
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Hooks",
          "type": "string"
        },
        "tick_spacing": {
          "maximum": 32767,
          "minimum": 1,
          "title": "Tick Spacing",
          "type": "integer"
        }
      },
      "required": [
