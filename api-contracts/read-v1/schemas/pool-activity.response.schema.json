    "PoolActivityLiveWindow": {
      "additionalProperties": false,
      "description": "A pool whose creation is verified but whose ledger is not walked yet.\n\nThe 24 h window is exact, computed from the pool's own logs over a block\nrange whose start timestamp proves every event lies inside the window. No\nstored revision, range model, lifetime total or fee ledger is claimed.",
      "properties": {
        "accountingScope": {
          "const": "core_pool_events_only",
          "title": "Accountingscope",
          "type": "string"
        },
        "chainId": {
          "const": 4663,
          "title": "Chainid",
          "type": "integer"
        },
        "coverage": {
          "$ref": "#/$defs/LiveWindowCoverage"
        },
        "executionAvailable": {
          "const": false,
          "title": "Executionavailable",
          "type": "boolean"
        },
        "fees": {
          "$ref": "#/$defs/ActivityFees"
        },
        "freshness": {
          "$ref": "#/$defs/ActivityFreshness"
        },
        "liquidity": {
          "$ref": "#/$defs/LiveWindowLiquidity"
        },
        "methodologyVersion": {
          "const": 1,
          "title": "Methodologyversion",
          "type": "integer"
        },
        "mode": {
          "const": "live_window_only",
          "title": "Mode",
          "type": "string"
        },
        "poolId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Poolid",
          "type": "string"
        },
        "poolKey": {
          "discriminator": {
            "mapping": {
              "dynamic": "#/$defs/DynamicPoolKey",
              "fixed": "#/$defs/FixedPoolKey"
            },
            "propertyName": "feeMode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedPoolKey"
            },
            {
              "$ref": "#/$defs/DynamicPoolKey"
            }
          ],
          "title": "Poolkey"
        },
        "revision": {
          "title": "Revision",
          "type": "null"
        },
        "schemaVersion": {
          "const": 1,
          "title": "Schemaversion",
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/StateSnapshot"
        },
        "storedEventCount": {
          "const": 0,
          "title": "Storedeventcount",
          "type": "integer"
        },
        "suggested": {
          "const": false,
          "title": "Suggested",
          "type": "boolean"
        },
        "window24h": {
          "$ref": "#/$defs/ActivityWindow"
        }
      },
      "required": [
        "schemaVersion",
        "methodologyVersion",
        "mode",
        "chainId",
        "poolId",
        "poolKey",
        "revision",
        "accountingScope",
        "snapshot",
        "coverage",
        "freshness",
        "window24h",
        "liquidity",
        "fees",
        "storedEventCount",
        "suggested",
        "executionAvailable"
      ],
      "title": "PoolActivityLiveWindow",
      "type": "object"
    },
    "PoolActivityStored": {
      "additionalProperties": false,
      "description": "A walked pool: the stored ledger answers with its own revision and model.",
      "properties": {
        "accountingScope": {
          "const": "core_pool_events_only",
          "title": "Accountingscope",
          "type": "string"
        },
        "chainId": {
          "const": 4663,
          "title": "Chainid",
          "type": "integer"
        },
        "coverage": {
          "$ref": "#/$defs/ActivityCoverage"
        },
        "executionAvailable": {
          "const": false,
          "title": "Executionavailable",
          "type": "boolean"
