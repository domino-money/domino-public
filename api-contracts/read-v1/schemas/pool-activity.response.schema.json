      "type": "object"
    },
    "LiveWindowCoverage": {
      "additionalProperties": false,
      "description": "Coverage of a window served from live state: no stored interval exists.",
      "properties": {
        "canonicality": {
          "const": "block_hash_rechecked",
          "title": "Canonicality",
          "type": "string"
        },
        "indexedThrough": {
          "title": "Indexedthrough",
          "type": "null"
        },
        "initializedAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Initializedat",
          "type": "integer"
        },
        "initializedBlock": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Initializedblock",
          "type": "integer"
        },
        "rpcCompleteness": {
          "const": "single_provider_assumption",
          "title": "Rpccompleteness",
          "type": "string"
        },
        "scope": {
          "const": "live_window_only",
          "title": "Scope",
          "type": "string"
        },
        "startBlock": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Startblock",
          "type": "integer"
        },
        "windowStartBlock": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Windowstartblock",
          "type": "integer"
        },
        "windowStartTimestamp": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Windowstarttimestamp",
          "type": "integer"
        }
      },
      "required": [
        "startBlock",
        "indexedThrough",
        "initializedBlock",
        "initializedAt",
        "scope",
        "canonicality",
        "rpcCompleteness",
        "windowStartBlock",
        "windowStartTimestamp"
      ],
      "title": "LiveWindowCoverage",
      "type": "object"
    },
    "LiveWindowLiquidity": {
      "additionalProperties": false,
      "properties": {
        "activeLiquidityRaw": {
          "$ref": "#/$defs/Raw"
        },
        "isTvl": {
          "const": false,
          "title": "Istvl",
          "type": "boolean"
        },
        "positionAccounting": {
          "discriminator": {
            "mapping": {
              "reconciled_as_of": "#/$defs/PositionsReconciled",
              "unavailable": "#/$defs/PositionsUnavailable"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PositionsUnavailable"
