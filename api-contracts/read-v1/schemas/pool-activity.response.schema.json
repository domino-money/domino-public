{
  "$defs": {
    "ActivityCoverage": {
      "additionalProperties": false,
      "properties": {
        "canonicality": {
          "const": "block_hash_rechecked",
          "title": "Canonicality",
          "type": "string"
        },
        "indexedThrough": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Indexedthrough",
          "type": "integer"
        },
        "initializedAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Initializedat",
          "type": "integer"
        },
        "initializedBlock": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Initializedblock",
          "type": "integer"
        },
        "rpcCompleteness": {
          "const": "single_provider_assumption",
          "title": "Rpccompleteness",
          "type": "string"
        },
        "scope": {
          "const": "since_verified_initialize",
          "title": "Scope",
          "type": "string"
        },
        "startBlock": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Startblock",
          "type": "integer"
        }
      },
      "required": [
        "startBlock",
        "indexedThrough",
        "initializedBlock",
        "initializedAt",
        "scope",
        "canonicality",
        "rpcCompleteness"
      ],
      "title": "ActivityCoverage",
      "type": "object"
    },
    "ActivityFees": {
      "additionalProperties": false,
      "properties": {
        "accounting": {
          "discriminator": {
            "mapping": {
              "reconciled_as_of": "#/$defs/FeesReconciled",
              "unavailable": "#/$defs/FeesUnavailable"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FeesUnavailable"
            },
            {
              "$ref": "#/$defs/FeesReconciled"
            }
          ],
          "title": "Accounting"
        },
        "feeGrowthGlobalX128": {
          "items": {
            "$ref": "#/$defs/Raw"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Feegrowthglobalx128",
          "type": "array"
        },
        "growthIncludesDonations": {
          "const": true,
          "title": "Growthincludesdonations",
          "type": "boolean"
        },
        "growthIsTokenAmount": {
          "const": false,
          "title": "Growthistokenamount",
          "type": "boolean"
        },
        "lpFeePipsAtSnapshot": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Lpfeepipsatsnapshot",
          "type": "integer"
        },
        "protocolDirectionalPips": {
          "items": {
            "maximum": 4095,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Protocoldirectionalpips",
          "type": "array"
        }
      },
      "required": [
        "protocolDirectionalPips",
        "lpFeePipsAtSnapshot",
        "feeGrowthGlobalX128",
        "growthIsTokenAmount",
        "growthIncludesDonations",
        "accounting"
      ],
      "title": "ActivityFees",
      "type": "object"
    },
    "ActivityFreshness": {
      "additionalProperties": false,
      "properties": {
        "ageSeconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Ageseconds",
          "type": "integer"
        },
        "checkedAgainstHead": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Checkedagainsthead",
          "type": "integer"
        },
        "status": {
          "enum": [
            "fresh",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "ageSeconds",
        "status",
        "checkedAgainstHead"
      ],
      "title": "ActivityFreshness",
      "type": "object"
    },
    "ActivityLiquidity": {
      "additionalProperties": false,
      "properties": {
        "activeLiquidityRaw": {
          "$ref": "#/$defs/Raw"
        },
        "isTvl": {
          "const": false,
          "title": "Istvl",
          "type": "boolean"
        },
        "positionAccounting": {
          "discriminator": {
            "mapping": {
              "reconciled_as_of": "#/$defs/PositionsReconciled",
              "unavailable": "#/$defs/PositionsUnavailable"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PositionsUnavailable"
            },
            {
              "$ref": "#/$defs/PositionsReconciled"
            }
          ],
          "title": "Positionaccounting"
        },
        "rangeCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Rangecount",
          "type": "integer"
        },
        "status": {
          "const": "core_active_liquidity_reconciled",
          "title": "Status",
          "type": "string"
        },
        "tvlReason": {
          "enum": [
            "timestamp_aligned_valuation_unavailable",
            "pool_assets_and_uncollected_fees_not_reconciled"
          ],
          "title": "Tvlreason",
          "type": "string"
        },
        "tvlUsd": {
          "title": "Tvlusd",
          "type": "null"
        }
      },
      "required": [
        "status",
        "activeLiquidityRaw",
        "rangeCount",
        "isTvl",
        "tvlUsd",
        "tvlReason",
        "positionAccounting"
      ],
      "title": "ActivityLiquidity",
      "type": "object"
    },
    "ActivityWindow": {
      "additionalProperties": false,
      "properties": {
        "completeWindow": {
          "title": "Completewindow",
          "type": "boolean"
        },
        "donations": {
          "$ref": "#/$defs/Donations"
        },
        "feeApr": {
          "title": "Feeapr",
          "type": "null"
        },
        "feeAprReason": {
          "enum": [
            "lp_fee_and_time_weighted_tvl_not_reconciled",
            "time_weighted_tvl_and_usd_valuation_not_reconciled"
          ],
          "title": "Feeaprreason",
          "type": "string"
        },
        "fromTimestampExclusive": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Fromtimestampexclusive",
          "type": "integer"
        },
        "lpFeesBasis": {
          "const": "core_trading_fee_before_Q128_distribution_rounding",
          "title": "Lpfeesbasis",
          "type": "string"
        },
        "lpFeesRaw": {
          "anyOf": [
            {
              "items": {
                "pattern": "^(0|[1-9][0-9]{0,155})$",
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lpfeesraw"
        },
        "lpFeesReason": {
          "anyOf": [
            {
              "enum": [
                "per_step_fee_accounting_not_reconciled",
                "fee_ledger_not_caught_up",
                "fee_accounting_adapter_required"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lpfeesreason"
        },
        "nonzeroSwapCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Nonzeroswapcount",
          "type": "integer"
        },
        "observedSeconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Observedseconds",
          "type": "integer"
        },
        "observedSinceTimestamp": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Observedsincetimestamp",
          "type": "integer"
        },
        "observedTotalSwapFeePips": {
          "items": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 50000,
          "title": "Observedtotalswapfeepips",
          "type": "array"
        },
        "protocolFeesRaw": {
          "items": {
            "pattern": "^(0|[1-9][0-9]{0,155})$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Protocolfeesraw",
          "type": "array"
        },
        "requestedSeconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Requestedseconds",
          "type": "integer"
        },
        "status": {
          "enum": [
            "covered_as_of",
            "pool_younger_than_window"
          ],
          "title": "Status",
          "type": "string"
        },
        "swapEventCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Swapeventcount",
          "type": "integer"
        },
        "swapLegsRaw": {
          "items": {
            "$ref": "#/$defs/SwapLeg"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Swaplegsraw",
          "type": "array"
        },
        "throughTimestamp": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Throughtimestamp",
          "type": "integer"
        },
        "usableAsCurrent24h": {
          "title": "Usableascurrent24H",
          "type": "boolean"
        },
        "volumeUsd": {
          "title": "Volumeusd",
          "type": "null"
        },
        "volumeUsdReason": {
          "const": "timestamp_aligned_valuation_unavailable",
          "title": "Volumeusdreason",
          "type": "string"
        }
      },
      "required": [
        "requestedSeconds",
        "fromTimestampExclusive",
        "throughTimestamp",
        "observedSinceTimestamp",
        "observedSeconds",
        "completeWindow",
        "status",
        "swapEventCount",
        "nonzeroSwapCount",
        "swapLegsRaw",
        "donations",
        "observedTotalSwapFeePips",
        "volumeUsd",
        "volumeUsdReason",
        "lpFeesRaw",
        "lpFeesReason",
        "feeApr",
        "feeAprReason",
        "usableAsCurrent24h"
      ],
      "title": "ActivityWindow",
      "type": "object"
    },
    "Donations": {
      "additionalProperties": false,
      "properties": {
        "amountsRaw": {
          "items": {
            "pattern": "^(0|[1-9][0-9]{0,155})$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Amountsraw",
          "type": "array"
        },
        "count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "count",
        "amountsRaw"
      ],
      "title": "Donations",
      "type": "object"
    },
    "DynamicPoolKey": {
      "additionalProperties": false,
      "properties": {
        "currency0": {
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency0",
          "type": "string"
        },
        "currency1": {
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency1",
          "type": "string"
        },
        "feeMode": {
          "const": "dynamic",
          "title": "Feemode",
          "type": "string"
        },
        "fee_pips": {
          "const": 8388608,
          "title": "Fee Pips",
          "type": "integer"
        },
        "hooks": {
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Hooks",
          "type": "string"
        },
        "tick_spacing": {
          "maximum": 32767,
          "minimum": 1,
          "title": "Tick Spacing",
          "type": "integer"
        }
      },
      "required": [
        "currency0",
        "currency1",
        "tick_spacing",
        "hooks",
        "feeMode",
        "fee_pips"
      ],
      "title": "DynamicPoolKey",
      "type": "object"
    },
    "FeesReconciled": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "core_trading_fee_before_Q128_distribution_rounding",
          "title": "Basis",
          "type": "string"
        },
        "donationsRaw": {
          "items": {
            "pattern": "^(0|[1-9][0-9]{0,155})$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Donationsraw",
          "type": "array"
        },
        "feeGrowthReconciled": {
          "const": true,
          "title": "Feegrowthreconciled",
          "type": "boolean"
        },
        "isCollectedAmount": {
          "const": false,
          "title": "Iscollectedamount",
          "type": "boolean"
        },
        "isDominoServiceFee": {
          "const": false,
          "title": "Isdominoservicefee",
          "type": "boolean"
        },
        "lpFeesRaw": {
          "items": {
            "pattern": "^(0|[1-9][0-9]{0,155})$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Lpfeesraw",
          "type": "array"
        },
        "methodologyVersion": {
          "const": 1,
          "title": "Methodologyversion",
          "type": "integer"
        },
        "protocolFeesRaw": {
          "items": {
            "pattern": "^(0|[1-9][0-9]{0,155})$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Protocolfeesraw",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "null"
        },
        "scope": {
          "const": "since_verified_initialize",
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "const": "reconciled_as_of",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "methodologyVersion",
        "status",
        "reason",
        "lpFeesRaw",
        "protocolFeesRaw",
        "donationsRaw",
        "basis",
        "isCollectedAmount",
        "isDominoServiceFee",
        "scope",
        "feeGrowthReconciled"
      ],
      "title": "FeesReconciled",
      "type": "object"
    },
    "FeesUnavailable": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "core_trading_fee_before_Q128_distribution_rounding",
          "title": "Basis",
          "type": "string"
        },
        "donationsRaw": {
          "title": "Donationsraw",
          "type": "null"
        },
        "isCollectedAmount": {
          "const": false,
          "title": "Iscollectedamount",
          "type": "boolean"
        },
        "isDominoServiceFee": {
          "const": false,
          "title": "Isdominoservicefee",
          "type": "boolean"
        },
        "lpFeesRaw": {
          "title": "Lpfeesraw",
          "type": "null"
        },
        "methodologyVersion": {
          "const": 1,
          "title": "Methodologyversion",
          "type": "integer"
        },
        "protocolFeesRaw": {
          "title": "Protocolfeesraw",
          "type": "null"
        },
        "reason": {
          "enum": [
            "fee_ledger_not_caught_up",
            "fee_accounting_adapter_required"
          ],
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unavailable",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "methodologyVersion",
        "status",
        "reason",
        "lpFeesRaw",
        "protocolFeesRaw",
        "donationsRaw",
        "basis",
        "isCollectedAmount",
        "isDominoServiceFee"
      ],
      "title": "FeesUnavailable",
      "type": "object"
    },
    "FixedPoolKey": {
      "additionalProperties": false,
      "properties": {
        "currency0": {
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency0",
          "type": "string"
        },
        "currency1": {
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency1",
          "type": "string"
        },
        "feeMode": {
          "const": "fixed",
          "title": "Feemode",
