{
  "$defs": {
    "BlockRef": {
      "additionalProperties": false,
      "description": "A block, shaped as read-v1's snapshot: what a read or an event is true at.",
      "properties": {
        "hash": {
          "maxLength": 66,
          "minLength": 66,
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "number": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "timestamp": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "hash",
        "timestamp"
      ],
      "title": "BlockRef",
      "type": "object"
    },
    "EthUsd": {
      "additionalProperties": false,
      "description": "The Chainlink ETH/USD round behind a price: the profile's feed (its proxy), the answer and its time.",
      "properties": {
        "feed": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Feed",
          "type": "string"
        },
        "roundId": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Roundid",
          "type": "string",
          "x-maximum-raw": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
        },
        "updatedAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Updatedat",
          "type": "integer"
        },
        "usd": {
          "maxLength": 43,
          "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{18}$",
          "title": "Usd",
          "type": "string"
        }
      },
      "required": [
        "feed",
        "usd",
        "roundId",
        "updatedAt"
      ],
      "title": "EthUsd",
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "ageSeconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Ageseconds",
          "type": "integer"
        },
        "status": {
          "enum": [
            "fresh",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "ageSeconds",
        "status"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "LivePool": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "anyOf": [
            {
              "maxLength": 42,
              "minLength": 42,
              "pattern": "^0x[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Address"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 66,
              "minLength": 66,
              "pattern": "^0x[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "liquidity": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Liquidity",
          "type": "string",
          "x-maximum-raw": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
        },
        "lpFeePips": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Lpfeepips",
          "type": "integer"
        },
        "market": {
          "$ref": "#/$defs/PoolMarket"
        },
        "pool": {
          "$ref": "#/$defs/PoolRef"
        },
        "protocolFee": {
          "maximum": 16777215,
          "minimum": 0,
          "title": "Protocolfee",
          "type": "integer"
        },
        "sqrtPriceX96": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Sqrtpricex96",
          "type": "string",
          "x-maximum-raw": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
        },
        "swapFeePips": {
          "$ref": "#/$defs/SwapFees"
        },
        "tick": {
          "maximum": 887272,
          "minimum": -887272,
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "pool",
        "id",
        "address",
        "sqrtPriceX96",
        "tick",
        "liquidity",
        "lpFeePips",
        "protocolFee",
        "swapFeePips",
        "market"
      ],
      "title": "LivePool",
      "type": "object"
    },
    "LiveToken": {
      "additionalProperties": false,
      "description": "A token's metadata as read at the block: untrusted text, decimals null when unread, never guessed; its USD\nprice, or why it has none.",
      "properties": {
        "address": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Address",
          "type": "string"
        },
        "decimals": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decimals"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenPrice"
            },
            {
              "type": "null"
            }
          ]
        },
        "priceReason": {
          "anyOf": [
            {
              "enum": [
                "no_qualified_price_source",
                "price_read_failed",
                "pricing_limit_reached",
                "decimals_unknown",
                "eth_usd_stale",
                "sequencer_down",
                "no_pool",
                "pool_depth_below_floor",
                "pool_depth_unmeasurable",
                "price_below_precision"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pricereason"
        },
        "status": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbol"
        }
      },
      "required": [
        "address",
        "symbol",
        "decimals",
        "status",
        "price",
        "priceReason"
      ],
      "title": "LiveToken",
      "type": "object"
    },
    "PoolMarket": {
      "additionalProperties": false,
      "description": "The pool's depth in USD within the band: what it releases of `reference`, the token's partner, as the token is\nsold into it until its price falls by PRICE_BAND_PERCENT. No TVL, volume or APR.",
      "properties": {
        "depthUsd": {
          "anyOf": [
            {
              "maxLength": 31,
              "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Depthusd"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no_qualified_reference",
                "price_read_failed",
                "eth_usd_stale",
                "sequencer_down",
                "pool_depth_unmeasurable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reference": {
          "anyOf": [
            {
              "maxLength": 42,
              "minLength": 42,
              "pattern": "^0x[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference"
        },
        "status": {
          "enum": [
            "measured",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reference",
        "depthUsd",
        "reason"
      ],
      "title": "PoolMarket",
      "type": "object"
    },
    "PoolRef": {
      "additionalProperties": false,
      "properties": {
        "currency0": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency0",
          "type": "string"
        },
        "currency1": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency1",
          "type": "string"
        },
        "dex": {
          "enum": [
            3,
            4
          ],
          "title": "Dex",
          "type": "integer"
        },
        "fee": {
          "maximum": 8388608,
          "minimum": 0,
          "title": "Fee",
          "type": "integer"
        },
        "hooks": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Hooks",
          "type": "string"
        },
        "tickSpacing": {
          "maximum": 32767,
          "minimum": 1,
          "title": "Tickspacing",
          "type": "integer"
        }
      },
      "required": [
        "dex",
        "currency0",
        "currency1",
        "fee",
        "tickSpacing",
        "hooks"
      ],
      "title": "PoolRef",
      "type": "object"
    },
    "SwapFees": {
      "additionalProperties": false,
      "description": "What a swap pays in each direction, in pips of its input: v4's protocol fee taken before the LP fee.",
      "properties": {
        "oneForZero": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Oneforzero",
          "type": "integer"
        },
        "zeroForOne": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Zeroforone",
          "type": "integer"
        }
      },
      "required": [
        "zeroForOne",
        "oneForZero"
      ],
      "title": "SwapFees",
      "type": "object"
    },
    "TokenPrice": {
      "additionalProperties": false,
      "description": "A qualified USD price: the chain's stable, the feed's ETH, or a pool's spot against one of them at the block read,\nwith the pool and its depth within the band.",
      "properties": {
        "depthUsd": {
          "anyOf": [
            {
              "maxLength": 31,
              "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Depthusd"
        },
        "ethUsd": {
          "anyOf": [
            {
              "$ref": "#/$defs/EthUsd"
            },
            {
              "type": "null"
            }
          ]
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "chain_stable",
            "chainlink_eth_usd",
            "pool"
          ],
          "title": "Source",
          "type": "string"
        },
        "usd": {
          "maxLength": 43,
          "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{18}$",
          "title": "Usd",
          "type": "string"
        }
      },
      "required": [
        "usd",
        "source",
        "snapshot",
        "ethUsd",
        "pool",
        "depthUsd"
      ],
      "title": "TokenPrice",
      "type": "object"
    }
  },
  "$id": "https://domino.invalid/contracts/read-v6/chain-pools.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "chain-pools: the token's pools against the chain's base currencies (or the paired token), Uniswap's standard\nhookless keys and the enabled v3 tiers, read at one block; listed when priced and holding liquidity.",
  "properties": {
    "chainId": {
      "enum": [
        4663,
        8453,
        42161
      ],
      "title": "Chainid",
      "type": "integer"
    },
    "contractVersion": {
      "enum": [
        "1.1.0-rc.1",
        "1.2.0-rc.1"
      ],
      "title": "Contractversion",
      "type": "string"
    },
    "coverage": {
      "const": "standard_hookless_pools",
      "title": "Coverage",
      "type": "string"
    },
    "executionAvailable": {
      "const": false,
      "title": "Executionavailable",
      "type": "boolean"
    },
    "freshness": {
      "$ref": "#/$defs/Freshness"
    },
    "limitations": {
      "items": {
        "enum": [
          "usd_from_qualified_sources_only",
          "token_metadata_untrusted",
          "state_as_of_last_read",
          "no_execution_or_signing"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Limitations",
      "type": "array"
    },
    "mode": {
      "const": "live_chain_pools",
      "title": "Mode",
      "type": "string"
    },
    "pairedToken": {
      "anyOf": [
        {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pairedtoken"
    },
    "pools": {
      "items": {
        "$ref": "#/$defs/LivePool"
      },
      "maxItems": 32,
      "title": "Pools",
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "servedAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Servedat",
      "type": "integer"
    },
    "snapshot": {
      "$ref": "#/$defs/BlockRef"
    },
    "token": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x[0-9a-f]{40}$",
      "title": "Token",
      "type": "string"
    },
    "tokens": {
      "items": {
        "$ref": "#/$defs/LiveToken"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Tokens",
      "type": "array"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "mode",
    "chainId",
    "token",
    "pairedToken",
    "servedAt",
    "snapshot",
    "freshness",
    "tokens",
    "pools",
    "truncated",
    "coverage",
    "limitations",
    "executionAvailable"
  ],
  "title": "ChainPoolsResponse",
  "type": "object",
  "x-contract-version": "1.1.0-rc.1"
}
