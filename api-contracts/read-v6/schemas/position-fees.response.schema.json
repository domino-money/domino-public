        "indexedThrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "lagSeconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lagseconds"
        },
        "lastError": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndexFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "fees_not_followed",
                "reading_back",
                "behind_index"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "status": {
          "enum": [
            "current",
            "stale",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "through": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockRef"
