{
  "$defs": {
    "BlockRef": {
      "additionalProperties": false,
      "description": "A block, shaped as read-v1's snapshot: what a read or an event is true at.",
      "properties": {
        "hash": {
          "maxLength": 66,
          "minLength": 66,
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "number": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "timestamp": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "hash",
        "timestamp"
      ],
      "title": "BlockRef",
      "type": "object"
    },
    "ChainBalances": {
      "additionalProperties": false,
      "description": "One chain's balances; `totalUsd` once every balance above zero has a value.",
      "properties": {
        "balances": {
          "items": {
            "$ref": "#/$defs/TokenBalance"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Balances",
          "type": "array"
        },
        "chainId": {
          "enum": [
            4663,
            8453,
            42161
          ],
          "title": "Chainid",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "chain_not_configured",
                "chain_read_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "current",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "totalUsd": {
          "anyOf": [
            {
              "maxLength": 31,
              "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Totalusd"
        }
      },
      "required": [
        "chainId",
        "status",
        "reason",
        "snapshot",
        "totalUsd",
        "balances"
      ],
      "title": "ChainBalances",
      "type": "object"
    },
    "EthUsd": {
      "additionalProperties": false,
      "description": "The Chainlink ETH/USD round behind a price: the profile's feed (its proxy), the answer and its time.",
      "properties": {
        "feed": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Feed",
          "type": "string"
        },
        "roundId": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Roundid",
          "type": "string",
          "x-maximum-raw": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
        },
        "updatedAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Updatedat",
          "type": "integer"
        },
        "usd": {
          "maxLength": 43,
          "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{18}$",
          "title": "Usd",
          "type": "string"
        }
      },
      "required": [
        "feed",
        "usd",
        "roundId",
        "updatedAt"
      ],
      "title": "EthUsd",
      "type": "object"
    },
    "PoolRef": {
      "additionalProperties": false,
      "properties": {
        "currency0": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency0",
          "type": "string"
        },
        "currency1": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency1",
          "type": "string"
        },
        "dex": {
          "enum": [
            3,
            4
          ],
          "title": "Dex",
          "type": "integer"
        },
        "fee": {
          "maximum": 8388608,
          "minimum": 0,
          "title": "Fee",
          "type": "integer"
        },
        "hooks": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Hooks",
          "type": "string"
        },
        "tickSpacing": {
          "maximum": 32767,
          "minimum": 1,
          "title": "Tickspacing",
          "type": "integer"
        }
      },
      "required": [
        "dex",
        "currency0",
        "currency1",
        "fee",
        "tickSpacing",
        "hooks"
      ],
      "title": "PoolRef",
      "type": "object"
    },
    "TokenBalance": {
      "additionalProperties": false,
      "description": "A balance as read, its token's USD price or why it has none, and its value at that price, rounded down.",
      "properties": {
        "address": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Address",
          "type": "string"
        },
        "balanceRaw": {
          "anyOf": [
            {
              "maxLength": 78,
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string",
              "x-maximum-raw": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
            },
            {
              "type": "null"
            }
          ],
          "title": "Balanceraw"
        },
        "decimals": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decimals"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenPrice"
            },
            {
              "type": "null"
            }
          ]
        },
        "priceReason": {
          "anyOf": [
            {
              "enum": [
                "no_qualified_price_source",
                "price_read_failed",
                "pricing_limit_reached",
                "decimals_unknown",
                "eth_usd_stale",
                "sequencer_down",
                "no_pool",
                "pool_depth_below_floor",
                "pool_depth_unmeasurable",
                "price_below_precision"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pricereason"
        },
        "status": {
          "enum": [
            "read",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbol"
        },
        "valueUsd": {
          "anyOf": [
            {
              "maxLength": 31,
              "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valueusd"
        }
      },
      "required": [
        "address",
        "symbol",
        "decimals",
        "balanceRaw",
        "status",
        "price",
        "priceReason",
        "valueUsd"
      ],
      "title": "TokenBalance",
      "type": "object"
    },
    "TokenPrice": {
      "additionalProperties": false,
      "description": "A qualified USD price: the chain's stable, the feed's ETH, or a pool's spot against one of them at the block read,\nwith the pool and its depth within the band.",
      "properties": {
        "depthUsd": {
          "anyOf": [
            {
              "maxLength": 31,
              "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Depthusd"
        },
        "ethUsd": {
          "anyOf": [
            {
              "$ref": "#/$defs/EthUsd"
            },
            {
              "type": "null"
            }
          ]
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "chain_stable",
            "chainlink_eth_usd",
            "pool"
          ],
          "title": "Source",
          "type": "string"
        },
        "usd": {
          "maxLength": 43,
          "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{18}$",
          "title": "Usd",
          "type": "string"
        }
      },
      "required": [
        "usd",
        "source",
        "snapshot",
        "ethUsd",
        "pool",
        "depthUsd"
      ],
      "title": "TokenPrice",
      "type": "object"
    }
  },
  "$id": "https://domino.invalid/contracts/read-v6/chain-balances.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "chain-balances: a wallet's native and token balances on each chain asked, one block per chain.",
  "properties": {
    "chains": {
      "items": {
        "$ref": "#/$defs/ChainBalances"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Chains",
      "type": "array"
    },
    "contractVersion": {
      "const": "1.1.0-rc.1",
      "title": "Contractversion",
      "type": "string"
    },
    "coverage": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "executionAvailable": {
      "const": false,
      "title": "Executionavailable",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "enum": [
          "usd_from_qualified_sources_only",
          "token_metadata_untrusted",
          "state_as_of_last_read",
          "no_execution_or_signing"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Limitations",
      "type": "array"
    },
    "mode": {
      "const": "live_chain_balances",
      "title": "Mode",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "servedAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Servedat",
      "type": "integer"
    },
    "totalUsd": {
      "anyOf": [
        {
          "maxLength": 31,
          "pattern": "^(0|[1-9][0-9]{0,23})\\.[0-9]{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Totalusd"
    },
    "wallet": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x[0-9a-f]{40}$",
      "title": "Wallet",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "mode",
    "wallet",
    "servedAt",
    "coverage",
    "chains",
    "totalUsd",
    "limitations",
    "executionAvailable"
  ],
  "title": "ChainBalancesResponse",
  "type": "object",
  "x-contract-version": "1.1.0-rc.1"
}
