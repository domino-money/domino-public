{
  "$defs": {
    "BlockRef": {
      "additionalProperties": false,
      "description": "A block, shaped as read-v1's snapshot: what a read or an event is true at.",
      "properties": {
        "hash": {
          "maxLength": 66,
          "minLength": 66,
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "number": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "timestamp": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "hash",
        "timestamp"
      ],
      "title": "BlockRef",
      "type": "object"
    },
    "ChainBalances": {
      "additionalProperties": false,
      "properties": {
        "balances": {
          "items": {
            "$ref": "#/$defs/TokenBalance"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Balances",
          "type": "array"
        },
        "chainId": {
          "enum": [
            4663,
            8453,
            42161
          ],
          "title": "Chainid",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "chain_not_configured",
                "chain_read_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "current",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "chainId",
        "status",
        "reason",
        "snapshot",
        "balances"
      ],
      "title": "ChainBalances",
      "type": "object"
    },
    "TokenBalance": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Address",
          "type": "string"
        },
        "balanceRaw": {
          "anyOf": [
            {
              "maxLength": 78,
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string",
              "x-maximum-raw": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
            },
            {
              "type": "null"
            }
          ],
          "title": "Balanceraw"
        },
        "decimals": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decimals"
        },
        "status": {
          "enum": [
            "read",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbol"
        }
      },
      "required": [
        "address",
        "symbol",
        "decimals",
        "balanceRaw",
        "status"
      ],
      "title": "TokenBalance",
      "type": "object"
    }
  },
  "$id": "https://domino.invalid/contracts/read-v6/chain-balances.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "chain-balances: a wallet's native and token balances on each chain asked, one block per chain.",
  "properties": {
    "chains": {
      "items": {
        "$ref": "#/$defs/ChainBalances"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Chains",
      "type": "array"
    },
    "contractVersion": {
      "const": "1.0.0-rc.1",
      "title": "Contractversion",
      "type": "string"
    },
    "coverage": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "executionAvailable": {
      "const": false,
      "title": "Executionavailable",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "enum": [
          "raw_amounts_no_usd_valuation",
          "token_metadata_untrusted",
          "state_as_of_last_read",
          "no_execution_or_signing"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Limitations",
      "type": "array"
    },
    "mode": {
      "const": "live_chain_balances",
      "title": "Mode",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "servedAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Servedat",
      "type": "integer"
    },
    "wallet": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x[0-9a-f]{40}$",
      "title": "Wallet",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "mode",
    "wallet",
    "servedAt",
    "coverage",
    "chains",
    "limitations",
    "executionAvailable"
  ],
  "title": "ChainBalancesResponse",
  "type": "object",
  "x-contract-version": "1.0.0-rc.1"
}
