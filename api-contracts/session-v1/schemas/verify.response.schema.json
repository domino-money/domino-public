{
  "$defs": {
    "AccountValidation": {
      "additionalProperties": false,
      "properties": {
        "blockHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Blockhash",
          "type": "string"
        },
        "blockNumber": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Blocknumber",
          "type": "string"
        },
        "method": {
          "const": "plain_eoa",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "method",
        "blockNumber",
        "blockHash"
      ],
      "title": "AccountValidation",
      "type": "object"
    },
    "Owner": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Address",
          "type": "string"
        },
        "chainId": {
          "maximum": 4663,
          "minimum": 4663,
          "title": "Chainid",
          "type": "integer"
        }
      },
      "required": [
        "address",
        "chainId"
      ],
      "title": "Owner",
      "type": "object"
    }
  },
  "$id": "https://domino.invalid/contracts/session-v1/verify.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticated": {
      "const": true,
      "title": "Authenticated",
      "type": "boolean"
    },
    "csrfToken": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "title": "Csrftoken",
      "type": "string"
    },
    "expiresAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "title": "Expiresat",
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/Owner"
    },
    "validation": {
      "$ref": "#/$defs/AccountValidation"
    }
  },
  "required": [
    "authenticated",
    "owner",
    "expiresAt",
    "csrfToken",
    "validation"
  ],
  "title": "AuthenticatedResult",
  "type": "object",
  "x-contract-version": "2.0.0",
  "x-domino-constraints": [
    "All timestamps are valid UTC calendar dates.",
    "Messages must be well-formed UTF-8 and at most 2048 bytes.",
    "Chain ID is the exact integer 4663 (no exponent/fraction/string/coercion).",
    "Schema scalars are strict, including literal booleans."
  ]
}
