{
  "$id": "https://domino.invalid/contracts/session-v1/challenge.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "challengeId": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Challengeid",
      "type": "string"
    },
    "expiresAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "title": "Expiresat",
      "type": "string"
    },
    "message": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "challengeId",
    "message",
    "expiresAt"
  ],
  "title": "ChallengeResult",
  "type": "object",
  "x-contract-version": "3.0.0-rc.3",
  "x-domino-constraints": [
    "All timestamps are valid UTC calendar dates.",
    "Messages must be well-formed UTF-8 and at most 2048 bytes.",
    "Chain ID is the exact integer 4663 (no exponent/fraction/string/coercion).",
    "Schema scalars are strict, including literal booleans."
  ]
}
