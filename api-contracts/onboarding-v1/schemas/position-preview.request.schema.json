{
  "$defs": {
    "PoolKeyModel": {
      "additionalProperties": false,
      "properties": {
        "currency0": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency0",
          "type": "string"
        },
        "currency1": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency1",
          "type": "string"
        },
        "fee_pips": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Fee Pips",
          "type": "integer"
        },
        "hooks": {
          "const": "0x0000000000000000000000000000000000000000",
          "title": "Hooks",
          "type": "string"
        },
        "tick_spacing": {
          "maximum": 32767,
          "minimum": 1,
          "title": "Tick Spacing",
          "type": "integer"
        }
      },
      "required": [
        "currency0",
        "currency1",
        "fee_pips",
        "tick_spacing",
        "hooks"
      ],
      "title": "PoolKeyModel",
      "type": "object"
    }
  },
  "$id": "https://domino.invalid/contracts/onboarding-v1/position-preview.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amountRaw": {
      "maxLength": 78,
      "pattern": "^[1-9][0-9]{0,77}$",
      "title": "Amountraw",
      "type": "string"
    },
    "budget0Raw": {
      "anyOf": [
        {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget0Raw"
    },
    "budget1Raw": {
      "anyOf": [
        {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget1Raw"
    },
    "chainId": {
      "maximum": 4663,
      "minimum": 4663,
      "title": "Chainid",
      "type": "integer"
    },
    "independentToken": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Independenttoken",
      "type": "string"
    },
    "nativeBalanceRaw": {
      "anyOf": [
        {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nativebalanceraw"
    },
    "nativeGasReserveRaw": {
      "anyOf": [
        {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nativegasreserveraw"
    },
    "poolId": {
      "maxLength": 66,
      "minLength": 66,
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Poolid",
      "type": "string"
    },
    "poolKey": {
      "$ref": "#/$defs/PoolKeyModel"
    },
    "slippageBps": {
      "maximum": 500,
      "minimum": 10,
      "title": "Slippagebps",
      "type": "integer"
    },
    "tickLower": {
      "maximum": 887272,
      "minimum": -887272,
      "title": "Ticklower",
      "type": "integer"
    },
    "tickUpper": {
      "maximum": 887272,
      "minimum": -887272,
      "title": "Tickupper",
      "type": "integer"
    }
  },
  "required": [
    "chainId",
    "poolId",
    "poolKey",
    "independentToken",
    "amountRaw",
    "tickLower",
    "tickUpper",
    "slippageBps"
  ],
  "title": "PositionRequest",
  "type": "object",
  "x-contract-version": "1.1.0",
  "x-domino-constraints": [
    "All scalars are strict; JSON number lexemes must be canonical safe integers.",
    "Raw token strings are exact canonical uint256 values (positive when specified).",
    "Pool keys are ordered, distinct, hookless and fixed fee; the backend verifies Keccak PoolId.",
    "Selected ticks must be spaced and ordered; the independent token must belong to the pool.",
    "Preview timestamps have a 30-second lifetime; position prepared deadline is 1200 seconds.",
    "Unknown values remain null; cost/status arithmetic must match the adapter projection.",
    "Session-derived owner, response identity and freshness are checked by the service.",
    "swap-route alone returns unsigned transactions, only for a Uniswap route it chose and simulated; the swap goes to the pinned Universal Router, its allowance through Permit2 for the exact input."
  ]
}
