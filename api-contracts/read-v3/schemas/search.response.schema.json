{
  "$defs": {
    "Acquisition": {
      "additionalProperties": false,
      "properties": {
        "nextAttemptAt": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nextattemptat"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "refreshing": {
          "title": "Refreshing",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "refreshing",
        "reason",
        "nextAttemptAt"
      ],
      "title": "Acquisition",
      "type": "object"
    },
    "MetadataIssues": {
      "additionalProperties": false,
      "properties": {
        "decimals": {
          "default": null,
          "enum": [
            "upstream_unavailable",
            "rpc_error",
            "rpc_call_gas_limit",
