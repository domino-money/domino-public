{
  "$id": "https://domino.invalid/contracts/read-v3/overview.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "afterPoolId": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Afterpoolid"
    },
    "limit": {
      "default": 24,
      "maximum": 24,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "poolIds": {
      "default": [],
      "items": {
        "pattern": "^0x[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 24,
      "title": "Poolids",
      "type": "array"
    },
    "revision": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "token": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token"
    }
  },
  "title": "OverviewRequest",
  "type": "object",
  "x-contract-version": "3.0.0-rc.1"
}
