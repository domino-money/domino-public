{
  "$id": "https://domino.invalid/contracts/crosschain-v1/quote.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amountRaw": {
      "maxLength": 78,
      "pattern": "^[1-9][0-9]{0,77}$",
      "title": "Amountraw",
      "type": "string"
    },
    "destinationChainId": {
      "enum": [
        4663,
        8453,
        42161
      ],
      "title": "Destinationchainid",
      "type": "integer"
    },
    "destinationGas": {
      "title": "Destinationgas",
      "type": "boolean"
    },
    "destinationToken": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Destinationtoken",
      "type": "string"
    },
    "originChainId": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Originchainid",
      "type": "integer"
    },
    "originToken": {
      "maxLength": 42,
      "minLength": 42,
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Origintoken",
      "type": "string"
    },
    "slippageBps": {
      "maximum": 500,
      "minimum": 10,
      "title": "Slippagebps",
      "type": "integer"
    }
  },
  "required": [
    "originChainId",
    "originToken",
    "destinationChainId",
    "destinationToken",
    "amountRaw",
    "slippageBps",
    "destinationGas"
  ],
  "title": "QuoteRequest",
  "type": "object",
  "x-contract-version": "1.0.0-rc.1"
}
