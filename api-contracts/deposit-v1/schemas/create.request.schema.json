          "type": "string"
        },
        "budget0Raw": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Budget0Raw",
          "type": "string",
          "x-maximum-raw": "340282366920938463463374607431768211455"
        },
        "budget1Raw": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Budget1Raw",
          "type": "string",
          "x-maximum-raw": "340282366920938463463374607431768211455"
        },
        "chainId": {
          "maximum": 4663,
          "minimum": 4663,
          "title": "Chainid",
          "type": "integer"
        },
        "independentToken": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Independenttoken",
          "type": "string"
        },
        "maxFeePerGasRaw": {
          "maxLength": 78,
          "pattern": "^[1-9][0-9]{0,77}$",
          "title": "Maxfeepergasraw",
          "type": "string"
        },
        "maxGasLimitRaw": {
          "maxLength": 78,
          "pattern": "^[1-9][0-9]{0,77}$",
          "title": "Maxgaslimitraw",
          "type": "string"
        },
        "maxPriorityFeePerGasRaw": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Maxpriorityfeepergasraw",
          "type": "string"
        },
        "nativeGasReserveRaw": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Nativegasreserveraw",
          "type": "string"
        },
        "poolId": {
          "maxLength": 66,
          "minLength": 66,
          "pattern": "^0x[0-9a-f]{64}$",
