        "tickLower": {
          "maximum": 887272,
          "minimum": -887272,
          "title": "Ticklower",
          "type": "integer"
        },
        "tickUpper": {
          "maximum": 887272,
          "minimum": -887272,
          "title": "Tickupper",
          "type": "integer"
        }
      },
      "required": [
        "chainId",
        "poolId",
        "poolKey",
        "independentToken",
        "amountRaw",
        "tickLower",
        "tickUpper",
        "slippageBps",
        "budget0Raw",
        "budget1Raw",
        "nativeGasReserveRaw",
        "maxGasLimitRaw",
        "maxFeePerGasRaw",
        "maxPriorityFeePerGasRaw"
      ],
      "title": "DepositSelection",
      "type": "object"
