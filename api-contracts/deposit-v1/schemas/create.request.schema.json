    "PoolKeyModel": {
      "additionalProperties": false,
      "properties": {
        "currency0": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency0",
          "type": "string"
        },
        "currency1": {
          "maxLength": 42,
          "minLength": 42,
          "pattern": "^0x[0-9a-f]{40}$",
          "title": "Currency1",
          "type": "string"
        },
        "fee_pips": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Fee Pips",
          "type": "integer"
        },
        "hooks": {
          "const": "0x0000000000000000000000000000000000000000",
          "title": "Hooks",
          "type": "string"
        },
        "tick_spacing": {
          "maximum": 32767,
          "minimum": 1,
          "title": "Tick Spacing",
          "type": "integer"
        }
      },
      "required": [
        "currency0",
        "currency1",
        "fee_pips",
        "tick_spacing",
        "hooks"
